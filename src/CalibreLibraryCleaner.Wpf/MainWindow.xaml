<Window x:Class="CalibreLibraryCleaner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibre Library Cleaner"
        Width="1100"
        Height="700"
        MinWidth="760"
        MinHeight="480">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NextMetadataDuplicateGroupCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviousMetadataDuplicateGroupCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding ToggleMetadataDuplicateDeferredCommand}" />
  </Window.InputBindings>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="2*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0"
             Target="{Binding ElementName=LibraryPathBox}"
             Content="_Library folder:" />
      <ComboBox x:Name="LibraryPathBox"
            Grid.Column="1"
            Margin="4,0,8,0"
            Padding="4"
            IsEditable="True"
            IsReadOnly="True"
            ItemsSource="{Binding PersistedLibraryPaths}"
            SelectedItem="{Binding SelectedPersistedLibraryPath}"
            Text="{Binding SelectedLibraryPath, Mode=OneWay}"
            AutomationProperties.Name="Selected or persisted Calibre library folder" />
      <Button Grid.Column="2"
              MinWidth="80"
              Margin="0,0,8,0"
              Padding="8,4"
              Content="_Browse..."
              Command="{Binding SelectLibraryCommand}"
              AutomationProperties.Name="Browse for Calibre library" />
      <Button Grid.Column="3"
              MinWidth="80"
              Margin="0,0,8,0"
              Padding="8,4"
              Content="_Load"
              Command="{Binding LoadPersistedSnapshotCommand}"
              AutomationProperties.Name="Load the persisted scan for the selected library" />
            <Button Grid.Column="4"
              MinWidth="80"
              Margin="0,0,8,0"
              Padding="8,4"
              Content="_Scan"
              Command="{Binding ScanCommand}" />
            <Button Grid.Column="5"
              MinWidth="80"
              Margin="0,0,8,0"
              Padding="8,4"
              Content="_Cancel"
              Command="{Binding CancelCommand}" />
      <Button Grid.Column="6"
              MinWidth="100"
              Margin="0,0,8,0"
              Padding="8,4"
              Content="_Exact cleanup"
              Command="{Binding ExactBinaryCleanupPlans.RemoveDuplicatesCommand}"
              AutomationProperties.Name="Run Exact cleanup"
              ToolTip="Run the unchanged Exact cleanup workflow for the current exact-only analysis" />
            <Button Grid.Column="7"
              MinWidth="120"
              Padding="8,4"
              Content="Candidate _cleanup"
              Command="{Binding CandidateCleanupCommand}"
              AutomationProperties.Name="{Binding CandidateCleanupAutomationName}"
              ToolTip="{Binding CandidateCleanupToolTip}" />
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <ProgressBar Height="16"
                   Minimum="0"
                   Maximum="100"
                   Value="{Binding ProgressPercentage, Mode=OneWay}"
                   IsIndeterminate="{Binding IsProgressIndeterminate}"
                   AutomationProperties.Name="Library scan progress" />
      <TextBlock Margin="0,4,0,0"
                 Text="{Binding StatusMessage}"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,0"
             Text="{Binding CandidateCleanupResultSummary}"
             FontWeight="Bold"
             TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2"
            Margin="0,12,0,0"
            Padding="8"
            BorderBrush="DarkRed"
            BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock FontWeight="Bold"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0"
                   Text="{Binding ErrorAction}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TabControl Grid.Row="3" Grid.RowSpan="2" Margin="0,12,0,0">
      <TabItem Header="_Library">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
          </Grid.RowDefinitions>
          <GroupBox Grid.Row="0" Header="Books">
            <DataGrid ItemsSource="{Binding Books}"
                      SelectedItem="{Binding SelectedBook}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      AutomationProperties.Name="Loaded books">
              <DataGrid.Columns>
                <DataGridTextColumn Width="70" Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Width="2*" Header="Title" Binding="{Binding Title}" />
                <DataGridTextColumn Width="2*" Header="Authors" Binding="{Binding Authors}" />
                <DataGridTextColumn Width="2*" Header="Author sort" Binding="{Binding AuthorSort}" />
                <DataGridTextColumn Width="3*" Header="Managed directory" Binding="{Binding RelativeDirectory}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
          <GroupBox Grid.Row="1" Margin="0,8,0,0" Header="Formats for selected book">
            <DataGrid ItemsSource="{Binding SelectedFormats}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      AutomationProperties.Name="Formats for selected book">
              <DataGrid.Columns>
                <DataGridTextColumn Width="80" Header="Format" Binding="{Binding Format}" />
                <DataGridTextColumn Width="*" Header="Stored name" Binding="{Binding StoredFileName}" />
                <DataGridTextColumn Width="2*" Header="Expected relative path" Binding="{Binding ExpectedRelativePath}" />
                <DataGridTextColumn Width="150" Header="File status" Binding="{Binding Status}" />
                <DataGridTextColumn Width="110" Header="Size" Binding="{Binding FileSize}" />
                <DataGridTextColumn Width="3*" Header="SHA-256" Binding="{Binding Sha256}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="_Exact file duplicates">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="These groups contain byte-identical files. The best located copy is retained automatically and the other format copies are proposed for removal."
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Text="Select another member row to change the keeper, or Skip a group. Remove duplicates processes every remaining eligible group, merges complementary formats when unambiguous, and deletes empty records."
                       TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0" DataContext="{Binding ExactBinaryCleanupPlans}">
                    <Button HorizontalAlignment="Left" Padding="12,6" Content="_Exact cleanup"
                      Command="{Binding RemoveDuplicatesCommand}" />
              <TextBlock Margin="0,5,0,0" Text="{Binding Status}" FontWeight="Bold" TextWrapping="Wrap" />
              <ProgressBar Height="14" Margin="0,5,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}" />
              <TextBlock Margin="0,3,0,0" Text="{Binding ProgressMessage}" TextWrapping="Wrap" />
              <TextBlock Margin="0,3,0,0" Text="{Binding ResultSummary}" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding ExactDuplicateSummary}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <GroupBox Grid.Row="1" Header="Exact binary file groups">
            <DataGrid ItemsSource="{Binding ExactDuplicateGroups}"
                      SelectedItem="{Binding SelectedExactDuplicateGroup}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      AutomationProperties.Name="Exact binary duplicate file groups">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="70" Header="Skip" Binding="{Binding Skip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn IsReadOnly="True" Width="110" Header="Size" Binding="{Binding FileSize}" />
                <DataGridTextColumn IsReadOnly="True" Width="90" Header="Files" Binding="{Binding FileCount}" />
                <DataGridTextColumn IsReadOnly="True" Width="90" Header="Records" Binding="{Binding RecordCount}" />
                <DataGridTextColumn IsReadOnly="True" Width="3*" Header="SHA-256" Binding="{Binding Sha256}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
          <GroupBox Grid.Row="2" Margin="0,8,0,0" Header="Select the copy to keep; double-click a row to open its book">
            <DataGrid ItemsSource="{Binding SelectedExactDuplicateMembers}"
                      SelectedItem="{Binding SelectedExactDuplicateMember}"
                      MouseDoubleClick="ExactDuplicateMembersGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AutomationProperties.Name="Records and formats in selected exact file group">
              <DataGrid.Columns>
                <DataGridTextColumn Width="90" Header="Action" Binding="{Binding CleanupAction}" />
                <DataGridTextColumn IsReadOnly="True" Width="80" Header="Record ID" Binding="{Binding BookId}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Title" Binding="{Binding Title}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Authors" Binding="{Binding Authors}" />
                <DataGridTextColumn IsReadOnly="True" Width="90" Header="Format" Binding="{Binding Format}" />
                <DataGridTextColumn IsReadOnly="True" Width="3*" Header="Relative path" Binding="{Binding ExpectedRelativePath}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="_Metadata candidates">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="These records have equal normalized titles and author sets. Review the generated keeper, skip groups that should remain unchanged, then process all remaining groups together."
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Text="Selecting a member changes the keeper. Every other record is removed after complementary formats are transferred; when the keeper already has the same format, the keeper's file wins."
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Text="{Binding MetadataDuplicateSummary}" TextWrapping="Wrap" />
          </StackPanel>
          <GroupBox Grid.Row="1" Header="Normalized metadata candidate groups">
            <DataGrid ItemsSource="{Binding MetadataDuplicateGroups}"
                      SelectedItem="{Binding SelectedMetadataDuplicateGroup}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Normalized metadata candidate groups">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="70" Header="Skip" Binding="{Binding Skip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Normalized title" Binding="{Binding NormalizedTitle}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Normalized author set" Binding="{Binding NormalizedAuthors}" />
                <DataGridTextColumn IsReadOnly="True" Width="80" Header="Records" Binding="{Binding RecordCount}" />
                <DataGridTextColumn IsReadOnly="True" Width="90" Header="Keeper ID" Binding="{Binding KeeperRecordId}" />
                <DataGridTextColumn IsReadOnly="True" Width="110" Header="Confidence" Binding="{Binding Confidence}" />
                <DataGridTextColumn IsReadOnly="True" Width="80" Header="Warnings" Binding="{Binding WarningCount}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Category" Binding="{Binding Category}" />
                <DataGridTextColumn IsReadOnly="True" Width="3*" Header="Match reason" Binding="{Binding Reason}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
          <GroupBox Grid.Row="2" Margin="0,8,0,0" Header="Select the record to keep; double-click a row to open its book">
            <DataGrid ItemsSource="{Binding SelectedMetadataDuplicateMembers}"
                      SelectedItem="{Binding SelectedMetadataDuplicateMember}"
                      MouseDoubleClick="MetadataCandidateMembersGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Records in selected metadata candidate group">
              <DataGrid.Columns>
                <DataGridTextColumn Width="80" Header="Action" Binding="{Binding Action}" />
                <DataGridTextColumn Width="70" Header="Record ID" Binding="{Binding BookId}" />
                <DataGridTextColumn Width="2*" Header="Original title" Binding="{Binding Title}" />
                <DataGridTextColumn Width="2*" Header="Original authors" Binding="{Binding Authors}" />
                <DataGridTextColumn Width="*" Header="Publisher" Binding="{Binding Publisher}" />
                <DataGridTextColumn Width="100" Header="Publication date" Binding="{Binding PublicationDate}" />
                <DataGridTextColumn Width="*" Header="Languages" Binding="{Binding Languages}" />
                <DataGridTextColumn Width="*" Header="Series/index" Binding="{Binding Series}" />
                <DataGridTextColumn Width="80" Header="Cover" Binding="{Binding HasCover}" />
                <DataGridTextColumn Width="3*" Header="Metadata quality" Binding="{Binding MetadataQualityFacts}" />
                <DataGridTextColumn Width="2*" Header="Formats/status" Binding="{Binding Formats}" />
                <DataGridTextColumn Width="2*" Header="Identifiers" Binding="{Binding Identifiers}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="_Unified candidates" AutomationProperties.Name="Unified candidate review">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Margin="0,0,0,8"
                     FontWeight="Bold"
                     Text="{Binding UnifiedCandidateSummary}"
                     TextWrapping="Wrap" />
          <GroupBox Grid.Row="1" Header="Unified candidate groups">
            <DataGrid ItemsSource="{Binding UnifiedCandidateGroups}"
                      SelectedItem="{Binding SelectedUnifiedCandidateGroup}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Unified candidate groups">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="65" Header="Skip">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Skip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Keeper title" Binding="{Binding KeeperTitle}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Keeper authors" Binding="{Binding KeeperAuthors}" />
                <DataGridTextColumn IsReadOnly="True" Width="85" Header="Keeper ID" Binding="{Binding KeeperRecordId}" />
                <DataGridTextColumn IsReadOnly="True" Width="105" Header="Eligibility" Binding="{Binding Eligibility}" />
                <DataGridTextColumn IsReadOnly="True" Width="85" Header="Language" Binding="{Binding Language}" />
                <DataGridTextColumn IsReadOnly="True" Width="70" Header="Records" Binding="{Binding RecordCount}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Evidence sources" Binding="{Binding EvidenceSources}" />
                <DataGridTextColumn IsReadOnly="True" Width="3*" Header="Evidence" Binding="{Binding Evidence}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Review findings" Binding="{Binding ReviewFindings}" />
                <DataGridTextColumn IsReadOnly="True" Width="3*" Header="Content comparison" Binding="{Binding ContentEvidence}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
          <GroupBox Grid.Row="2" Margin="0,8,0,0" Header="Select the record to keep; double-click a row to open its book">
            <DataGrid ItemsSource="{Binding SelectedUnifiedCandidateMembers}"
                      SelectedItem="{Binding SelectedUnifiedCandidateMember}"
                      MouseDoubleClick="UnifiedCandidateMembersGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Members in selected unified candidate group">
              <DataGrid.Columns>
                <DataGridTextColumn Width="80" Header="Action" Binding="{Binding Action}" />
                <DataGridTextColumn Width="70" Header="Record ID" Binding="{Binding BookId}" />
                <DataGridTextColumn Width="2*" Header="Title" Binding="{Binding Title}" />
                <DataGridTextColumn Width="2*" Header="Authors" Binding="{Binding Authors}" />
                <DataGridTextColumn Width="100" Header="Languages" Binding="{Binding Languages}" />
                <DataGridTextColumn Width="*" Header="Series/index" Binding="{Binding Series}" />
                <DataGridTextColumn Width="2*" Header="Formats/status" Binding="{Binding Formats}" />
                <DataGridTextColumn Width="3*" Header="Keeper ranking" Binding="{Binding RetentionFacts}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="E_xpanded candidates" AutomationProperties.Name="Expanded content-confirmed candidates">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontWeight="Bold"
                       Text="{Binding ExpandedCandidateSummary}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Text="Select the sole keeper in each content-confirmed group. Other records are removed after complementary formats are transferred; metadata is not rewritten."
                       TextWrapping="Wrap" />
          </StackPanel>
          <GroupBox Grid.Row="1" Header="Work-language groups">
            <DataGrid ItemsSource="{Binding ExpandedCandidateGroups}"
                      SelectedItem="{Binding SelectedExpandedCandidateGroup}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Expanded work-language candidate groups">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="70" Header="Skip">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Skip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn IsReadOnly="True" Width="95" Header="Eligibility" Binding="{Binding Eligibility}" />
                <DataGridTextColumn IsReadOnly="True" Width="90" Header="Language" Binding="{Binding Language}" />
                <DataGridTextColumn IsReadOnly="True" Width="100" Header="Confidence" Binding="{Binding Confidence}" />
                <DataGridTextColumn IsReadOnly="True" Width="75" Header="Records" Binding="{Binding RecordCount}" />
                <DataGridTextColumn IsReadOnly="True" Width="90" Header="Keeper ID" Binding="{Binding KeeperRecordId}" />
                <DataGridTextColumn IsReadOnly="True" Width="3*" Header="Evidence" Binding="{Binding Evidence}" />
                <DataGridTextColumn IsReadOnly="True" Width="2*" Header="Contradictions" Binding="{Binding Contradictions}" />
                <DataGridTextColumn IsReadOnly="True" Width="3*" Header="Content evidence" Binding="{Binding ContentEvidence}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
          <GroupBox Grid.Row="2" Margin="0,8,0,0" Header="Select the record to keep; double-click a row to open its book">
            <DataGrid ItemsSource="{Binding SelectedExpandedCandidateMembers}"
                      SelectedItem="{Binding SelectedExpandedCandidateMember}"
                      MouseDoubleClick="ExpandedCandidateMembersGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Members in selected expanded candidate group">
              <DataGrid.Columns>
                <DataGridTextColumn Width="90" Header="Action" Binding="{Binding Action}" />
                <DataGridTextColumn Width="75" Header="Record ID" Binding="{Binding BookId}" />
                <DataGridTextColumn Width="2*" Header="Title" Binding="{Binding Title}" />
                <DataGridTextColumn Width="2*" Header="Authors" Binding="{Binding Authors}" />
                <DataGridTextColumn Width="100" Header="Languages" Binding="{Binding Languages}" />
                <DataGridTextColumn Width="*" Header="Series/index" Binding="{Binding Series}" />
                <DataGridTextColumn Width="2*" Header="Formats/status" Binding="{Binding Formats}" />
                <DataGridTextColumn Width="3*" Header="Keeper ranking" Binding="{Binding RetentionFacts}" />
              </DataGrid.Columns>
            </DataGrid>
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="_EPUB assessments" AutomationProperties.Name="EPUB assessments">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DataGrid Grid.Row="0"
                    ItemsSource="{Binding EpubAssessments}"
                    SelectedItem="{Binding SelectedEpubAssessment}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    AutomationProperties.Name="EPUB assessment summary">
            <DataGrid.Columns>
              <DataGridTextColumn Width="70" Header="Book ID" Binding="{Binding BookId}" />
              <DataGridTextColumn Width="*" Header="Calibre title (context)" Binding="{Binding BookTitle}" />
              <DataGridTextColumn Width="2*" Header="Expected path" Binding="{Binding ExpectedRelativePath}" />
              <DataGridTextColumn Width="110" Header="Status" Binding="{Binding Status}" />
              <DataGridTextColumn Width="150" Header="Coverage" Binding="{Binding Coverage}" />
              <DataGridTextColumn Width="190" Header="Score" Binding="{Binding Score}" SortMemberPath="ScoreSortValue" />
              <DataGridTextColumn Width="70" Header="Opened" Binding="{Binding Opened}" />
              <DataGridTextColumn Width="100" Header="Package" Binding="{Binding PackageParsed}" />
              <DataGridTextColumn Width="80" Header="EPUB" Binding="{Binding PackageVersion}" />
              <DataGridTextColumn Width="140" Header="Analyzer" Binding="{Binding AnalyzerVersion}" />
              <DataGridTextColumn Width="140" Header="Scoring model" Binding="{Binding ScoringModelVersion}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Margin="0,8,0,4" TextWrapping="Wrap" Text="{Binding EpubAssessmentStatusMessage}" FontWeight="Bold" AutomationProperties.Name="EPUB assessment status" />
          <TextBlock Grid.Row="2" Margin="0,4,0,8" TextWrapping="Wrap" Text="{Binding SelectedEpubFeatureSummary}" AutomationProperties.Name="Selected EPUB bounded feature summary" />
          <Grid Grid.Row="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Label Target="{Binding ElementName=EpubFindingFilter}" Content="Finding _severity:" />
              <ComboBox x:Name="EpubFindingFilter" MinWidth="140" ItemsSource="{Binding EpubFindingFilterModes}" SelectedItem="{Binding EpubFindingFilterMode}" AutomationProperties.Name="Filter EPUB findings by severity" />
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding EpubFindings}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="EPUB assessment findings">
              <DataGrid.Columns>
                <DataGridTextColumn Width="110" Header="Severity" Binding="{Binding Severity}" />
                <DataGridTextColumn Width="220" Header="Rule" Binding="{Binding RuleId}" />
                <DataGridTextColumn Width="90" Header="Adjustment" Binding="{Binding Adjustment}" />
                <DataGridTextColumn Width="2*" Header="Explanation" Binding="{Binding Explanation}" />
                <DataGridTextColumn Width="2*" Header="Evidence" Binding="{Binding Evidence}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="_PDF assessments" AutomationProperties.Name="PDF assessments">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DataGrid Grid.Row="0" ItemsSource="{Binding PdfAssessments}" SelectedItem="{Binding SelectedPdfAssessment}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    AutomationProperties.Name="PDF assessment summary">
            <DataGrid.Columns>
              <DataGridTextColumn Width="70" Header="Book ID" Binding="{Binding BookId}" />
              <DataGridTextColumn Width="*" Header="Calibre title (context)" Binding="{Binding BookTitle}" />
              <DataGridTextColumn Width="2*" Header="Expected path" Binding="{Binding ExpectedRelativePath}" />
              <DataGridTextColumn Width="110" Header="Status" Binding="{Binding Status}" />
              <DataGridTextColumn Width="150" Header="Score" Binding="{Binding Score}" />
              <DataGridTextColumn Width="150" Header="Classification" Binding="{Binding Classification}" />
              <DataGridTextColumn Width="90" Header="Confidence" Binding="{Binding Confidence}" />
              <DataGridTextColumn Width="80" Header="Pages" Binding="{Binding PageCount}" />
              <DataGridTextColumn Width="160" Header="Sampling" Binding="{Binding Sampling}" />
              <DataGridTextColumn Width="170" Header="Encryption" Binding="{Binding Encryption}" />
              <DataGridTextColumn Width="140" Header="Analyzer" Binding="{Binding AnalyzerVersion}" />
              <DataGridTextColumn Width="140" Header="Scoring model" Binding="{Binding ScoringModelVersion}" />
              <DataGridTextColumn Width="150" Header="Classification policy" Binding="{Binding ClassificationVersion}" />
              <DataGridTextColumn Width="140" Header="Resource profile" Binding="{Binding ResourceProfileVersion}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Margin="0,8,0,4" TextWrapping="Wrap" Text="{Binding PdfDisqualificationMessage}" FontWeight="Bold" AutomationProperties.Name="PDF disqualification status" />
          <TextBlock Grid.Row="2" Margin="0,4,0,8" TextWrapping="Wrap" Text="{Binding SelectedPdfFeatureSummary}" AutomationProperties.Name="Selected PDF bounded feature and classification summary" />
          <Grid Grid.Row="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Label Target="{Binding ElementName=PdfFindingFilter}" Content="Finding _severity:" />
              <ComboBox x:Name="PdfFindingFilter" MinWidth="140" ItemsSource="{Binding PdfFindingFilterModes}" SelectedItem="{Binding PdfFindingFilterMode}" AutomationProperties.Name="Filter PDF findings by severity" />
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding PdfFindings}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="PDF assessment findings">
              <DataGrid.Columns>
                <DataGridTextColumn Width="110" Header="Severity" Binding="{Binding Severity}" />
                <DataGridTextColumn Width="220" Header="Rule" Binding="{Binding RuleId}" />
                <DataGridTextColumn Width="130" Header="Component" Binding="{Binding Component}" />
                <DataGridTextColumn Width="90" Header="Adjustment" Binding="{Binding Adjustment}" />
                <DataGridTextColumn Width="2*" Header="Explanation" Binding="{Binding Explanation}" />
                <DataGridTextColumn Width="2*" Header="Evidence" Binding="{Binding Evidence}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
