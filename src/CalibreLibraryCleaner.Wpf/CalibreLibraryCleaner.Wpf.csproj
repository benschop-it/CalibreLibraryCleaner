<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalibreLibraryCleaner.Application\CalibreLibraryCleaner.Application.csproj" />
    <ProjectReference Include="..\CalibreLibraryCleaner.Infrastructure\CalibreLibraryCleaner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <Target Name="CopyPdfInspectionWorker" AfterTargets="Build">
    <ItemGroup>
      <_PdfInspectionWorkerFile Include="$(MSBuildThisFileDirectory)..\CalibreLibraryCleaner.PdfWorker\bin\$(Configuration)\net10.0\CalibreLibraryCleaner.PdfWorker*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PdfInspectionWorkerFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
