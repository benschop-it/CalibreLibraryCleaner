<Window x:Class="CalibreLibraryCleaner.Wpf.OnlineMetadataSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Online metadata settings"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.Resources>
      <Style x:Key="SettingsActionButton" TargetType="Button">
        <Setter Property="IsEnabled" Value="True" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsBusy}" Value="True">
            <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               FontWeight="Bold"
               Text="Online metadata providers"
               FontSize="15" />
    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               TextWrapping="Wrap"
               Text="Open Library and Google Books receive either ISBN only, or title, author names, and optional two-letter language. No library paths or book content are transmitted. Google Books additionally receives the API key below." />
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="Open Library is available independently without a key." />
      <TextBlock Margin="0,4,0,8" Text="{Binding GoogleBooksStatus}" />
      <Label Target="{Binding ElementName=GoogleBooksApiKeyBox}"
             Content="Google Books API _key:" />
      <PasswordBox x:Name="GoogleBooksApiKeyBox"
                   MaxLength="256"
                   AutomationProperties.Name="Google Books API key" />
    </StackPanel>
    <TextBlock Grid.Row="3"
               Margin="0,8,0,0"
               Text="{Binding StatusMessage}"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="4"
                Margin="0,16,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button MinWidth="100"
              Margin="0,0,8,0"
              Padding="8,4"
              Content="{Binding SaveActionLabel}"
              Style="{StaticResource SettingsActionButton}"
              Click="SaveKey_Click" />
      <Button MinWidth="90"
              Margin="0,0,8,0"
              Padding="8,4"
              Content="_Clear key"
              Style="{StaticResource SettingsActionButton}"
              Click="ClearKey_Click" />
      <Button MinWidth="80"
              Padding="8,4"
              Content="_Close"
              Style="{StaticResource SettingsActionButton}"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>